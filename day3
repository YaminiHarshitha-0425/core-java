  **STRING METHODS**

1.length()	
->Returns the length of a string.	
"Hello".length() → 5
2.charAt()	
->Returns a character at a given index.
"Hello".charAt(1) → e
3.toUpperCase()
->Converts to uppercase.	
"hello".toUpperCase() → HELLO
4.toLowerCase()	
->Converts to lowercase.	
"HELLO".toLowerCase() → hello
5.equals()
->Compares two strings.	
"Java".equals("Java") → true
6.equalsIgnoreCase()	
->Compares strings ignoring case.	
"Java".equalsIgnoreCase("JAVA") → true
7.concat()
->Joins two strings.
"Hello".concat(" World")
8.substring()	
->Extracts part of a string.	
"Hello".substring(1,4) → ell
9.contains()
->Checks whether text is present.	
"Hello".contains("ell") → true
10.indexOf()	
->Returns the position of a character or text.	
"Hello".indexOf('l') → 2
11.replace()
->Replaces characters or text.
"Hello".replace('l','p') → Heppo
12.trim()	
->Removes leading and trailing spaces.
" Hi ".trim() → Hi
13.startsWith()	
->Checks the beginning of a string.	
"Java".startsWith("Ja") → true
14.endsWith()
->Checks the ending of a string.	
"Java".endsWith("va") → true
15.isEmpty()	
->Checks whether a string is empty.	
"".isEmpty() → true
    **SAMPLE CODE***

class StringMethods {
    public static void main(String[] args) {

        String str = "Hello Java Programming";
        String str2 = "hello java programming";

        // 1. length()
        System.out.println("Length: " + str.length());

        // 2. charAt()
        System.out.println("Character at index 1: " + str.charAt(1));

        // 3. toUpperCase()
        System.out.println("Uppercase: " + str.toUpperCase());

        // 4. toLowerCase()
        System.out.println("Lowercase: " + str.toLowerCase());

        // 5. trim()
        String s = "   Hello Java   ";
        System.out.println("Trim: " + s.trim());

        // 6. strip()
        System.out.println("Strip: " + s.strip());

        // 7. substring()
        System.out.println("Substring: " + str.substring(6));

        // 8. substring(begin, end)
        System.out.println("Substring: " + str.substring(0, 5));

        // 9. equals()
        System.out.println("Equals: " + str.equals(str2));

        // 10. equalsIgnoreCase()
        System.out.println("Equals Ignore Case: " +
                str.equalsIgnoreCase(str2));

        // 11. compareTo()
        System.out.println("CompareTo: " + str.compareTo(str2));

        // 12. compareToIgnoreCase()
        System.out.println("Compare Ignore Case: " +
                str.compareToIgnoreCase(str2));

        // 13. contains()
        System.out.println("Contains Java: " + str.contains("Java"));

        // 14. startsWith()
        System.out.println("Starts With Hello: " + str.startsWith("Hello"));

        // 15. endsWith()
        System.out.println("Ends With Programming: " +
                str.endsWith("Programming"));

        // 16. indexOf()
        System.out.println("Index Of Java: " + str.indexOf("Java"));

        // 17. lastIndexOf()
        System.out.println("Last Index Of a: " + str.lastIndexOf("a"));

        // 18. replace()
        System.out.println("Replace: " + str.replace("Java", "Python"));

        // 19. replaceFirst()
        System.out.println("Replace First: " +
                str.replaceFirst("a", "A"));

        // 20. replaceAll()
        System.out.println("Replace All: " +
                str.replaceAll("a", "A"));

        // 21. isEmpty()
        String empty = "";
        System.out.println("Is Empty: " + empty.isEmpty());

        // 22. isBlank()
        String blank = "   ";
        System.out.println("Is Blank: " + blank.isBlank());

        // 23. concat()
        System.out.println("Concat: " + str.concat(" Language"));

        // 24. repeat()
        System.out.println("Repeat: " + "Java ".repeat(3));

        // 25. toCharArray()
        char[] arr = str.toCharArray();
        System.out.print("Character Array: ");
        for (char ch : arr) {
            System.out.print(ch + " ");
        }
        System.out.println();

        // 26. split()
        String fruits = "Apple,Banana,Mango";
        String[] fruitArray = fruits.split(",");
        System.out.println("Split:");
        for (String fruit : fruitArray) {
            System.out.println(fruit);
        }

        // 27. matches()
        System.out.println("Matches: " + "12345".matches("\\d+"));

        // 28. valueOf()
        int num = 100;
        String result = String.valueOf(num);
        System.out.println("Value Of: " + result);

        // 29. join()
        System.out.println("Join: " +
                String.join("-", "Java", "Python", "C"));

        // 30. intern()
        String str3 = new String("Java");
        String str4 = str3.intern();
        System.out.println("Intern: " + str4);

        // 31. formatted()
        System.out.println("Formatted: " +
                "My name is %s and age is %d".formatted("Ravi", 20));

        // 32. indent()
        System.out.println("Indent: " + "Hello\nJava".indent(4));

        // 33. lines()
        System.out.println("Lines:");
        "Hello\nJava\nWorld".lines().forEach(System.out::println);
    }
}

